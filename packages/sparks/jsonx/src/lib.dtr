// Sparks Seed Package: jsonx
// Lightweight JSON validation and inspection.

fn count_tokens(json_src: String) -> Int {
    let len = str_len(json_src)
    mut idx = 0
    mut count = 0
    while idx < len {
        let ch = str_char_at(json_src, idx)
        if ch == "{" || ch == "}" || ch == "[" || ch == "]" || ch == ":" || ch == "," {
            count = count + 1
        }
        idx = idx + 1
    }
    return count
}

fn validate_brackets(json_src: String) -> Bool {
    let len = str_len(json_src)
    mut idx = 0
    mut curly_depth = 0
    mut square_depth = 0
    while idx < len {
        let ch = str_char_at(json_src, idx)
        if ch == "{" {
            curly_depth = curly_depth + 1
        } else if ch == "}" {
            curly_depth = curly_depth - 1
            if curly_depth < 0 {
                return false
            }
        } else if ch == "[" {
            square_depth = square_depth + 1
        } else if ch == "]" {
            square_depth = square_depth - 1
            if square_depth < 0 {
                return false
            }
        }
        idx = idx + 1
    }
    return curly_depth == 0 && square_depth == 0
}
