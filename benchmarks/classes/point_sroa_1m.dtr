class Point {
    x: Int
    y: Int
}

fn compute_points(n: Int) -> Int {
    mut total = 0
    mut i = 0
    while i < n {
        let p = Point { x: i, y: 1 }
        total = total + p.x + p.y
        i = i + 1
    }
    return total
}

fn main() {
    let res = compute_points(1000000)
    out res
}
