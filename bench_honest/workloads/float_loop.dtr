// Kernel: float accumulation, same runtime-derived trip count.
fn compute(n Int) -> Float {
    mut sum = 0.0
    mut i = 0
    while i < n {
        sum = sum + i * 2.0
        i = i + 1
    }
    return sum
}

fn main() {
    n = 500000000 + now_ms() / 10000000000000
    a = now_ms()
    r = compute(n)
    b = now_ms()
    out r
    out b - a
}
