// Kernel: struct built and consumed inside the loop. If SROA works, the
// aggregate never reaches memory.
class Point {
    x Int
    y Int
}

fn compute(n Int) -> Int {
    mut total = 0
    mut i = 0
    while i < n {
        p = Point { x: i, y: 1 }
        total = total + p.x + p.y
        i = i + 1
    }
    return total
}

fn main() {
    n = 200000000 + now_ms() / 10000000000000
    a = now_ms()
    r = compute(n)
    b = now_ms()
    out r
    out b - a
}
