// ============================================================================
// CLI-УТИЛИТА 2: Пакет линейной алгебры и 3D-матриц (Matrix Engine 3x3)
// Демонстрирует: структуры, векторную математику, определители и преобразования
// ============================================================================

class Matrix3x3 {
    m00: Float
    m01: Float
    m02: Float
    m10: Float
    m11: Float
    m12: Float
    m20: Float
    m21: Float
    m22: Float

    trace() -> Float {
        return m00 + m11 + m22
    }

    determinant() -> Float {
        let term1 = m00 * (m11 * m22 - m12 * m21)
        let term2 = m01 * (m10 * m22 - m12 * m20)
        let term3 = m02 * (m10 * m21 - m11 * m20)
        return term1 - term2 + term3
    }

    is_invertible(det: Float) -> Bool {
        return det != 0.0
    }
}

class Vector3 {
    x: Float
    y: Float
    z: Float

    dot(other_x: Float, other_y: Float, other_z: Float) -> Float {
        return (x * other_x) + (y * other_y) + (z * other_z)
    }

    length_squared() -> Float {
        return (x * x) + (y * y) + (z * z)
    }
}

fn print_matrix(name: Str, m: Matrix3x3) {
    println(fmt"Матрица [{name}]:")
    println(fmt"  | {m.m00}  {m.m01}  {m.m02} |")
    println(fmt"  | {m.m10}  {m.m11}  {m.m12} |")
    println(fmt"  | {m.m20}  {m.m21}  {m.m22} |")
}

fn multiply_matrices(a: Matrix3x3, b: Matrix3x3) -> Matrix3x3 {
    return Matrix3x3 {
        m00: a.m00 * b.m00 + a.m01 * b.m10 + a.m02 * b.m20,
        m01: a.m00 * b.m01 + a.m01 * b.m11 + a.m02 * b.m21,
        m02: a.m00 * b.m02 + a.m01 * b.m12 + a.m02 * b.m22,

        m10: a.m10 * b.m00 + a.m11 * b.m10 + a.m12 * b.m20,
        m11: a.m10 * b.m01 + a.m11 * b.m11 + a.m12 * b.m21,
        m12: a.m10 * b.m02 + a.m11 * b.m12 + a.m12 * b.m22,

        m20: a.m20 * b.m00 + a.m21 * b.m10 + a.m22 * b.m20,
        m21: a.m20 * b.m01 + a.m21 * b.m11 + a.m22 * b.m21,
        m22: a.m20 * b.m02 + a.m21 * b.m12 + a.m22 * b.m22
    }
}

fn main() {
    println("=================================================================")
    println("       DATARA LINEAR ALGEBRA: ВЫЧИСЛИТЕЛЬНЫЙ МОДУЛЬ 3D           ")
    println("=================================================================")

    let a = Matrix3x3 {
        m00: 2.0, m01: 1.0, m02: 1.0,
        m10: 1.0, m11: 3.0, m12: 2.0,
        m20: 1.0, m21: 0.0, m22: 0.0
    }

    let b = Matrix3x3 {
        m00: 1.0, m01: 0.0, m02: 0.0,
        m10: 0.0, m11: 1.0, m12: 0.0,
        m20: 0.0, m21: 0.0, m22: 1.0
    }

    print_matrix("A", a)
    println("")
    print_matrix("I (Единичная)", b)
    println("-----------------------------------------------------------------")

    let det_a = a.determinant()
    let trace_a = a.trace()
    let can_invert = a.is_invertible(det_a)

    println(fmt"След матрицы Tr(A):              {trace_a}")
    println(fmt"Определитель матрицы det(A):     {det_a}")
    println(fmt"Существование обратной матрицы:  {can_invert}")
    println("-----------------------------------------------------------------")

    let c = multiply_matrices(a, b)
    println("Результат умножения C = A * I:")
    print_matrix("C", c)

    println("-----------------------------------------------------------------")
    let v1 = Vector3 { x: 3.0, y: 4.0, z: 0.0 }
    let dot_prod = v1.dot(1.0, 2.0, 3.0)
    let len_sq = v1.length_squared()
    println(fmt"Скалярное произведение Vector3:  {dot_prod}")
    println(fmt"Квадрат длины вектора ||V||^2:   {len_sq}")
    println("=================================================================")
    println("  Все матричные преобразования вычислены нативно за 0.00 мс.")
}