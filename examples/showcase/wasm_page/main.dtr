fn compute_pi_approx(n: Float) -> Float {
    mut sum = 0.0
    mut sign = 1.0
    mut i = 0.0
    while i < n {
        let denom = 2.0 * i + 1.0
        require denom > 0.0
        mut term = sign / denom
        sum = sum + term
        sign = -sign
        i = i + 1.0
    }
    return sum * 4.0
}

fn add_numbers(a: Int, b: Int) -> Int {
    return a + b
}

fn main() {
    let pi = compute_pi_approx(10000.0)
    let sum = add_numbers(40, 2)
    out "Datara WASM Core Active"
    out pi
    out sum
}
