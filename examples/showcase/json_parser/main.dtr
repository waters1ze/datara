// Deterministic JSON Tokenizer and Validator in pure Datara

fn is_whitespace(ch: String) -> Bool {
    return ch == " " || ch == "\t" || ch == "\n" || ch == "\r"
}

fn is_digit(ch: String) -> Bool {
    return ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" ||
           ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9"
}

fn tokenize_json(input: String) -> Int {
    let len = str_len(input)
    mut idx = 0
    mut tokens_count = 0

    while idx < len {
        let ch = str_char_at(input, idx)
        if is_whitespace(ch) {
            idx = idx + 1
        } else if ch == "{" || ch == "}" || ch == "[" || ch == "]" || ch == ":" || ch == "," {
            tokens_count = tokens_count + 1
            idx = idx + 1
        } else if ch == "\"" {
            tokens_count = tokens_count + 1
            idx = idx + 1
            mut closed = false
            while idx < len && !closed {
                let sc = str_char_at(input, idx)
                if sc == "\"" {
                    closed = true
                }
                idx = idx + 1
            }
        } else if is_digit(ch) || ch == "-" {
            tokens_count = tokens_count + 1
            idx = idx + 1
            while idx < len && is_digit(str_char_at(input, idx)) {
                idx = idx + 1
            }
        } else {
            // Identifier (true, false, null)
            tokens_count = tokens_count + 1
            idx = idx + 1
            while idx < len && !is_whitespace(str_char_at(input, idx)) && str_char_at(input, idx) != "," && str_char_at(input, idx) != "}" && str_char_at(input, idx) != "]" {
                idx = idx + 1
            }
        }
    }
    return tokens_count
}

fn main() {
    let json_payload = "{\"id\": 101, \"user\": \"watersize\", \"admin\": true, \"scores\": [98, 100, 95], \"meta\": {\"version\": \"1.0.0\"}}"
    let count = tokenize_json(json_payload)
    out("[JSON Parser Showcase] Successfully parsed tokens: " + int_to_str(count))
    if count == 31 {
        out("[JSON Parser Showcase] Verification: 100% OK")
    } else {
        out("[JSON Parser Showcase] Error: token count mismatch")
    }
}
