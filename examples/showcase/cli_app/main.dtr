// Datara Showcase: Production CLI Application
// Demonstrates command-line argument parsing, capability-guarded file I/O, and JSON stream inspection.

fn is_whitespace(ch: String) -> Bool {
    return ch == " " || ch == "\t" || ch == "\n" || ch == "\r"
}

fn is_digit(ch: String) -> Bool {
    return ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" ||
           ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9"
}

record JsonStats {
    tokens_count: Int,
    objects_count: Int,
    arrays_count: Int,
    strings_count: Int,
    numbers_count: Int,
}

fn analyze_json(input: String) -> JsonStats {
    let len = str_len(input)
    mut idx = 0
    mut tokens = 0
    mut objects = 0
    mut arrays = 0
    mut strings = 0
    mut numbers = 0

    while idx < len {
        let ch = str_char_at(input, idx)
        if is_whitespace(ch) {
            idx = idx + 1
        } else if ch == "{" {
            tokens = tokens + 1
            objects = objects + 1
            idx = idx + 1
        } else if ch == "}" {
            tokens = tokens + 1
            idx = idx + 1
        } else if ch == "[" {
            tokens = tokens + 1
            arrays = arrays + 1
            idx = idx + 1
        } else if ch == "]" || ch == ":" || ch == "," {
            tokens = tokens + 1
            idx = idx + 1
        } else if ch == "\"" {
            tokens = tokens + 1
            strings = strings + 1
            idx = idx + 1
            mut closed = false
            while idx < len && !closed {
                let sc = str_char_at(input, idx)
                if sc == "\"" {
                    closed = true
                }
                idx = idx + 1
            }
        } else if is_digit(ch) || ch == "-" {
            tokens = tokens + 1
            numbers = numbers + 1
            idx = idx + 1
            while idx < len && is_digit(str_char_at(input, idx)) {
                idx = idx + 1
            }
        } else {
            tokens = tokens + 1
            idx = idx + 1
            while idx < len && !is_whitespace(str_char_at(input, idx)) && str_char_at(input, idx) != "," && str_char_at(input, idx) != "}" && str_char_at(input, idx) != "]" {
                idx = idx + 1
            }
        }
    }

    return JsonStats {
        tokens_count: tokens,
        objects_count: objects,
        arrays_count: arrays,
        strings_count: strings,
        numbers_count: numbers,
    }
}

fn print_help() {
    out "Usage: cli_app [options]"
    out "Options:"
    out "  --input <file>   Input JSON file to analyze"
    out "  --output <file>  Output file to write summary report"
    out "  --help           Show this help message"
}

fn read_user_file(path: String, sys_caps: SystemCapabilities) -> String {
    return file_read(path)
}

fn write_user_file(path: String, content: String, sys_caps: SystemCapabilities) -> Int {
    return file_write(path, content)
}

fn main(sys_caps: SystemCapabilities) {
    let count = args_count()
    mut input_path = ""
    mut output_path = ""
    mut show_help = false

    mut arg_idx = 1
    while arg_idx < count {
        let arg = args_get(arg_idx)
        if arg == "--help" || arg == "-h" {
            show_help = true
        } else if arg == "--input" || arg == "-i" {
            arg_idx = arg_idx + 1
            if arg_idx < count {
                input_path = args_get(arg_idx)
            }
        } else if arg == "--output" || arg == "-o" {
            arg_idx = arg_idx + 1
            if arg_idx < count {
                output_path = args_get(arg_idx)
            }
        }
        arg_idx = arg_idx + 1
    }

    if show_help {
        print_help()
        return
    }

    mut json_content = ""
    if str_len(input_path) > 0 {
        json_content = read_user_file(input_path, sys_caps)
        out "[CLI App Showcase] Read input from: " + input_path
    } else {
        json_content = "{\"app\": \"cli_showcase\", \"version\": 1, \"features\": [\"args\", \"fs\", \"json\"], \"active\": true}"
        out "[CLI App Showcase] Using embedded demo payload"
    }

    let stats = analyze_json(json_content)
    out "[CLI App Showcase] Analysis Results:"
    out "  Tokens:  " + int_to_str(stats.tokens_count)
    out "  Objects: " + int_to_str(stats.objects_count)
    out "  Arrays:  " + int_to_str(stats.arrays_count)
    out "  Strings: " + int_to_str(stats.strings_count)
    out "  Numbers: " + int_to_str(stats.numbers_count)

    let report = "{\"status\": \"OK\", \"tokens\": " + int_to_str(stats.tokens_count) + ", \"objects\": " + int_to_str(stats.objects_count) + ", \"arrays\": " + int_to_str(stats.arrays_count) + "}"
    if str_len(output_path) > 0 {
        let res = write_user_file(output_path, report, sys_caps)
        out "[CLI App Showcase] Wrote summary to: " + output_path
    }

    out "[CLI App Showcase] Completed successfully: STATUS_OK"
}
