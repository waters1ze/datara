// ============================================================================
// CLI-УТИЛИТА 3: Встраиваемая база данных абитуриентов (In-Memory Database Engine)
// Демонстрирует: реляционные структуры, фильтрацию, агрегацию и форматирование таблиц
// ============================================================================

class Applicant {
    id: Int
    name: Str
    faculty: Str
    score: Int

    admission_status() -> Str => decide {
        score >= 85 => "Бюджет (Грант)",
        score >= 70 => "Коммерция (Платное)",
        else => "Не прошел по конкурсу"
    }

    is_accepted() -> Bool {
        return score >= 70
    }
}

fn print_row(id: Int, name: Str, faculty: Str, score: Int, status: Str) {
    println(fmt" | {id}  | {name}    | {faculty}        |  {score}  | {status}")
}

fn main() {
    println("================================================================================")
    println("           DATARA DB: ИНФОРМАЦИОННАЯ СИСТЕМА ПРИЕМНОЙ КОМИССИИ          ")
    println("================================================================================")

    let a1 = Applicant { id: 101, name: "Смирнов А.", faculty: "Информатика", score: 96 }
    let a2 = Applicant { id: 102, name: "Иванова М.", faculty: "Приклад. мат.", score: 88 }
    let a3 = Applicant { id: 103, name: "Кузнецов Д.", faculty: "Робототехника", score: 76 }
    let a4 = Applicant { id: 104, name: "Попова Е.  ", faculty: "Кибербезопас.", score: 64 }
    let a5 = Applicant { id: 105, name: "Васильев К.", faculty: "Искусств. инт.", score: 92 }

    println(" +-----+--------------+----------------------+-------+-------------------------+")
    println(" | ID  | Абитуриент   | Направление          | Балл  | Решение комиссии        |")
    println(" +-----+--------------+----------------------+-------+-------------------------+")

    print_row(a1.id, a1.name, a1.faculty, a1.score, a1.admission_status())
    print_row(a2.id, a2.name, a2.faculty, a2.score, a2.admission_status())
    print_row(a3.id, a3.name, a3.faculty, a3.score, a3.admission_status())
    print_row(a4.id, a4.name, a4.faculty, a4.score, a4.admission_status())
    print_row(a5.id, a5.name, a5.faculty, a5.score, a5.admission_status())

    println(" +-----+--------------+----------------------+-------+-------------------------+")

    // Агрегированная статистика (SQL AVG, COUNT, MAX)
    let total_applicants = 5
    let total_score = a1.score + a2.score + a3.score + a4.score + a5.score
    let avg_score = (total_score * 1.0) / (total_applicants * 1.0)

    mut accepted_count = 0
    if a1.is_accepted() { accepted_count = accepted_count + 1 }
    if a2.is_accepted() { accepted_count = accepted_count + 1 }
    if a3.is_accepted() { accepted_count = accepted_count + 1 }
    if a4.is_accepted() { accepted_count = accepted_count + 1 }
    if a5.is_accepted() { accepted_count = accepted_count + 1 }

    let acceptance_rate = ((accepted_count * 1.0) / (total_applicants * 1.0)) * 100.0

    println("--------------------------------------------------------------------------------")
    println(fmt"Всего заявлений обработано:         {total_applicants}")
    println(fmt"Количество зачисленных студентов:   {accepted_count}")
    println(fmt"Процент успешного поступления:       {acceptance_rate}%")
    println(fmt"Средний балл по потоку (AVG Score): {avg_score}")
    println("================================================================================")
    println("  Запрос SELECT/AGGREGATE выполнен нативно за 0.00 мс.")
}