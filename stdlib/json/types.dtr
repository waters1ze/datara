class JsonValue {
    kind: Str
    str_val: Str
    int_val: Int
    float_val: Float
    bool_val: Bool
}

behavior JsonValue {
    null_val() -> JsonValue {
        return JsonValue {
            kind: "null",
            str_val: "",
            int_val: 0,
            float_val: 0.0,
            bool_val: false
        }
    }

    string_val(s: Str) -> JsonValue {
        return JsonValue {
            kind: "str",
            str_val: s,
            int_val: 0,
            float_val: 0.0,
            bool_val: false
        }
    }

    int_val(n: Int) -> JsonValue {
        return JsonValue {
            kind: "int",
            str_val: "",
            int_val: n,
            float_val: 0.0,
            bool_val: false
        }
    }

    bool_val(b: Bool) -> JsonValue {
        return JsonValue {
            kind: "bool",
            str_val: "",
            int_val: 0,
            float_val: 0.0,
            bool_val: b
        }
    }

    object_val(raw_pairs: Str) -> JsonValue {
        return JsonValue {
            kind: "object",
            str_val: raw_pairs,
            int_val: 0,
            float_val: 0.0,
            bool_val: false
        }
    }

    float_val(f: Float) -> JsonValue {
        return JsonValue {
            kind: "float",
            str_val: "",
            int_val: 0,
            float_val: f,
            bool_val: false
        }
    }

    array_val(raw_items: Str) -> JsonValue {
        return JsonValue {
            kind: "array",
            str_val: raw_items,
            int_val: 0,
            float_val: 0.0,
            bool_val: false
        }
    }

    as_str() -> Str {
        return this.str_val
    }

    as_int() -> Int {
        return this.int_val
    }

    as_float() -> Float {
        return this.float_val
    }

    as_bool() -> Bool {
        return this.bool_val
    }

    is_null() -> Bool {
        return this.kind == "null"
    }

    get(key: Str) -> Str {
        if this.kind != "object" {
            return ""
        }
        let pattern = "\"" + key + "\":"
        let idx = str_index_of(this.str_val, pattern)
        if idx < 0 {
            return ""
        }
        return this.str_val
    }
}
