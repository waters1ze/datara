class f32x4 {
    x: Float
    y: Float
    z: Float
    w: Float
}

behavior f32x4 {
    add(other: f32x4) -> f32x4 {
        return f32x4_add(this, other)
    }
    sub(other: f32x4) -> f32x4 {
        return f32x4_sub(this, other)
    }
    mul(other: f32x4) -> f32x4 {
        return f32x4_mul(this, other)
    }
    div(other: f32x4) -> f32x4 {
        return f32x4_div(this, other)
    }
    dot(other: f32x4) -> Float {
        return f32x4_dot(this, other)
    }
    cross(other: f32x4) -> f32x4 {
        return f32x4_cross(this, other)
    }
    horizontal_add() -> Float {
        return f32x4_horizontal_add(this)
    }
    min(other: f32x4) -> f32x4 {
        return f32x4_min(this, other)
    }
    max(other: f32x4) -> f32x4 {
        return f32x4_max(this, other)
    }
    lerp(other: f32x4, t: Float) -> f32x4 {
        return f32x4_lerp(this, other, t)
    }
    normalize() -> f32x4 {
        return f32x4_normalize(this)
    }
    distance(other: f32x4) -> Float {
        return f32x4_distance(this, other)
    }
}

