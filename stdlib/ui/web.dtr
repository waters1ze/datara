class HtmlTag {
    name: Str
    class_name: Str
    content: Str
}

behavior HtmlTag {
    render() -> Str {
        let class_attr = if this.class_name == "" { "" } else { " class='" + this.class_name + "'" }
        return "<" + this.name + class_attr + ">" + this.content + "</" + this.name + ">"
    }
}

class WebApp {
    title: Str
    theme_color: Str
}

behavior WebApp {
    div(class_name: Str, content: Str) -> Str {
        let tag = HtmlTag { name: "div", class_name: class_name, content: content }
        return tag.render()
    }

    button(class_name: Str, label: Str) -> Str {
        let tag = HtmlTag { name: "button", class_name: "btn " + class_name, content: label }
        return tag.render()
    }

    h1(title: Str) -> Str {
        let tag = HtmlTag { name: "h1", class_name: "header-title", content: title }
        return tag.render()
    }

    p(text: Str) -> Str {
        let tag = HtmlTag { name: "p", class_name: "text-body", content: text }
        return tag.render()
    }

    card(title: Str, body: Str) -> Str {
        let head = "<div class='card-header'><h3>" + title + "</h3></div>"
        let content = "<div class='card-body'>" + body + "</div>"
        return "<div class='web-card'>" + head + content + "</div>"
    }

    css_reset() -> Str {
        return "* { box-sizing: border-box; margin: 0; padding: 0; } body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0b0f19; color: #f3f4f6; padding: 24px; } .web-card { background: #131b2e; border: 1px solid #1f293d; border-radius: 12px; padding: 20px; margin-bottom: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.4); } .card-header h3 { color: #00f0ff; margin-bottom: 12px; } .btn { padding: 10px 18px; border-radius: 8px; border: none; font-weight: 700; cursor: pointer; transition: 0.15s; } .btn-primary { background: #00f0ff; color: #0b0f19; } .btn-primary:hover { background: #38bdf8; }"
    }

    render_page(body_content: Str) -> Str {
        let head = "<!DOCTYPE html><html lang='en'><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width, initial-scale=1.0'><title>" + this.title + "</title><style>" + this.css_reset() + "</style></head><body>"
        let layout = "<div class='container' style='max-width: 900px; margin: 0 auto;'>" + body_content + "</div>"
        let footer = "</body></html>"
        return head + layout + footer
    }
}
